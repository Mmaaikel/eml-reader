---
import { site } from '~/site'
import Base from '~/layouts/Base.astro'
import type { Props as BaseProps } from '~/layouts/Base.astro'

export interface Props extends BaseProps {}

const baseProps: BaseProps = {
	...site,
	...Astro.props,
	title: Astro.props.title
		? (site.title ? `${Astro.props.title} – ${site.title}` : Astro.props.title)
		: (site.title || undefined),
}

// Social images must be absolute URLs; only emit one when the site URL is known
const socialImage = Astro.props.socialImage ?? site.socialImage
baseProps.socialImage = socialImage && Astro.site
	? new URL(String(socialImage), Astro.site).href
	: undefined
---

<Base {...baseProps}>

	<slot slot="head" name="head" />

	<slot />

</Base>
