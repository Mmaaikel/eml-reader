---
import { i18nFactory } from '~/i18n'
import { githubRepositoryUrl } from '~/site'
const _ = i18nFactory(Astro.currentLocale as any)

export interface Props
{
	class?: string
	style?: string
}

const githubSha = process.env.GITHUB_SHA || null as string | null
const buildVersion = githubSha ? githubSha.slice(0, 7) : 'dev'
---

<footer
	id="footer"
	class:list={['footer', Astro.props.class]}
	style={Astro.props.style}
>
	<section>
		<h2>
			<span class="icon-[mdi--shield-lock-outline]"></span>
			{_('Data privacy')}
		</h2>
		<p>
			{_('No data is collected or processed over the network or on any server.')}{' '}
			{_('All data is processed locally in your browser, and stays on your own device.')}
		</p>
		<p>{_('This website uses no cookies and does no tracking.')}</p>
	</section>

	<section>
		<h2>
			<span class="icon-[mdi--code-braces]"></span>
			{_('Open source project')}
		</h2>
		<p>
			{_('See the source code on')}{' '}
			<a href={githubRepositoryUrl}>GitHub</a>
			<span class="version tabular">v. {buildVersion}</span>
		</p>
		<p>
			{_({ en: 'Made by', fr: 'Créé par' })}{' '}
			<a href="https://github.com/Mmaaikel">Maikel</a>,{' '}
			{_({ en: 'based on the original by', fr: 'd\'après l\'original de' })}{' '}
			<a href="https://github.com/matiboux/eml-reader">Matiboux</a>.{' '}
			{_('Built with')}{' '}<a href="https://astro.build/">Astro</a>.
		</p>
	</section>
</footer>

<style lang="scss">
@reference "#tailwind.css";

.footer {
	@apply mt-auto grid gap-8 border-t border-book-700 py-10 text-sm leading-relaxed text-book-300 sm:grid-cols-2 sm:gap-16;
}

h2 {
	@apply mb-2 flex items-center gap-2 font-display text-[15px] font-semibold uppercase tracking-[0.1em] text-book-100;

	span {
		@apply text-base text-book-300;
	}
}

p {
	@apply max-w-[60ch];

	+ p {
		@apply mt-1.5;
	}
}

a {
	@apply text-book-100 underline decoration-book-500 decoration-1;
	transition: text-decoration-color 150ms ease-out;

	&:hover {
		@apply decoration-book-100;
	}
}

.version {
	@apply ml-1 text-book-400;
}
</style>
