---
import { getLocaleUrlList } from '~/i18n'

export interface Props
{
	class?: string
	style?: string
}

const localeMetadata: Record<string, { short: string, label: string }> = {
	en: { short: 'EN', label: 'English' },
	fr: { short: 'FR', label: 'Français' },
}
---

<nav
	class:list={['locale-switch', Astro.props.class]}
	style={Astro.props.style}
	aria-label="Language / Langue"
>
	{getLocaleUrlList(Astro.url).map(({ locale, url }) =>
		{
			const meta = localeMetadata[locale]
			const current = Astro.currentLocale === locale
			return (
				<a
					href={url}
					class:list={['locale', { current }]}
					lang={locale}
					aria-current={current ? 'page' : undefined}
					title={meta?.label ?? locale}
				>
					{meta?.short ?? locale.toUpperCase()}
				</a>
			)
		})
	}
</nav>

<style lang="scss">
@reference "#tailwind.css";

.locale-switch {
	@apply flex items-center rounded border border-book-600 p-0.5;
}

.locale {
	@apply rounded-[3px] px-2 py-1 text-[13px] font-semibold tracking-wide text-book-300 no-underline;
	transition: color 150ms ease-out, background-color 150ms ease-out;

	&:hover {
		@apply text-book-100;
	}

	&.current {
		@apply bg-book-600 text-white;
	}
}
</style>
