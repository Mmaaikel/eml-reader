---
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locales } from '~/i18n/type.d.ts'
import Layout from '~/layouts/Layout.astro'
import AppModal from '~/components/AppModal.svelte'
import LocaleSwitch from '~/components/LocaleSwitch.astro'
import AppForm from '~/components/AppForm.svelte'
import AppContent from '~/components/AppContent.svelte'
import OpenFileButton from '~/components/OpenFileButton.svelte'
import Footer from '~/components/Footer.astro'

import { i18nFactory } from '~/i18n'
const locale = Astro.currentLocale as Locales | undefined
const _ = i18nFactory(locale)
---

<Layout lang={locale ?? 'en'} bodyClass="min-h-screen">

	<AppModal locale={locale} client:load />

	<div class="page">
		<header class="topbar">
			<a href={getRelativeLocaleUrl(locale ?? 'en', '')} class="wordmark">
				<span class="mark" aria-hidden="true"><span class="icon-[mdi--email-open-outline]"></span></span>
				EML <b>Reader</b>
			</a>
			<div class="topbar-end">
				<p class="promise">
					<span class="icon-[mdi--shield-lock-outline]"></span>
					{_({
						en: 'Stays on this device. Nothing is uploaded.',
						fr: 'Reste sur cet appareil. Rien n\'est envoyé.',
					})}
				</p>
				<LocaleSwitch />
				<OpenFileButton locale={locale} client:load />
			</div>
		</header>

		<p class="promise-mobile">
			<span class="icon-[mdi--shield-lock-outline]"></span>
			{_({
				en: 'Stays on this device. Nothing is uploaded.',
				fr: 'Reste sur cet appareil. Rien n\'est envoyé.',
			})}
		</p>

		<main class="stage">
			<AppForm locale={locale} client:load />
			<AppContent locale={locale} client:load />
		</main>

		<Footer />
	</div>

</Layout>

<style lang="scss">
@reference "#tailwind.css";

.page {
	@apply mx-auto flex min-h-screen w-full max-w-[1280px] flex-col px-4 sm:px-8 lg:px-10;
}

.topbar {
	@apply flex h-16 items-center justify-between gap-4 border-b border-book-700;
}

.wordmark {
	@apply flex items-center gap-2.5 font-display text-[22px] font-bold tracking-[0.01em] text-book-100 no-underline;

	b {
		color: var(--color-carmine-bright);
	}
}

.mark {
	@apply flex h-8 w-8 items-center justify-center rounded-[3px] bg-white text-lg text-ultramarine;
}

.topbar-end {
	@apply flex items-center gap-3 sm:gap-5;
}

.promise {
	@apply hidden items-center gap-1.5 text-[15px] text-book-200 md:flex;

	span {
		@apply text-lg text-olive-light;
	}
}

.promise-mobile {
	@apply flex items-center gap-1.5 border-b border-book-700 py-2.5 text-sm text-book-200 md:hidden;

	span {
		@apply text-base text-olive-light;
	}
}

.stage {
	@apply flex flex-1 flex-col py-8 sm:py-10;
	overflow-x: clip;
	overflow-clip-margin: 1rem;
}
</style>
