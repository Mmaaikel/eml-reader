{
  "name": "eml-reader",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workdir",
  "shutdownAction": "stopCompose",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "app" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mhutchie.git-graph",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
